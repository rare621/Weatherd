<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/wbg_pcloud_d">
<TextView android:id="@+id/place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your town" android:textSize="13.5sp" android:textColor="#FFFFFFFF" android:shadowColor="#55000000" android:shadowRadius="4" android:shadowDy="1" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:alpha="0.85"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/temp" android:layout_height="wrap_content" android:text="58°" android:textSize="46.5sp" android:textColor="#FFFFFFFF" android:shadowColor="#55000000" android:shadowRadius="4" android:shadowDy="1"  android:layout_width="0dp" android:layout_weight="1" android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
  <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/wi_pcloud_d" />
</LinearLayout>
<TextView android:id="@+id/cond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partly cloudy" android:textSize="16.0sp" android:textColor="#FFFFFFFF" android:shadowColor="#55000000" android:shadowRadius="4" android:shadowDy="1" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/hilo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H 61° L 50°" android:textSize="14.5sp" android:textColor="#FFFFFFFF" android:shadowColor="#55000000" android:shadowRadius="4" android:shadowDy="1"  android:alpha="0.9"/>
<TextView android:id="@+id/quip" android:layout_height="wrap_content" android:text="Nice day. Don\'t fuck it up." android:textSize="14.0sp" android:textColor="#FFFFFFFF" android:shadowColor="#55000000" android:shadowRadius="4" android:shadowDy="1" android:textStyle="bold" android:layout_width="match_parent" android:layout_marginTop="4dp" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>
